field f: Int

method test01(S:Array[Ref], a:Int)
  requires 0 <= a && a < |S|
  requires forall j:Int :: (0 <= j && j < |S|) ==> acc(S[j].f, write)
  ensures forall j:Int :: (0 <= j && j < |S|) ==> acc(S[j].f, write)
{
  S[a].f := 2
}


